generator client {
  provider = "prisma-client-js"
}

//ze teraz klient jest generowany do node modules @prisma w roocie, i z tego korzysta databaseservice!
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
enum UserRole {
  ADMIN
  REGULAR
}
 
model UserBlock {
  id         String   @id @default(cuid())   // easy cursors
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())
 
  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived",  fields: [blockedId], references: [id], onDelete: Cascade)
 
  @@unique([blockerId, blockedId]) // no duplicate blocks
  @@index([blockerId])
  @@index([blockedId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  phoneNumber  String   @unique // moze byc array of phone nums?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
 
  role UserRole @default(REGULAR)
  @@index([role])
 
  bio          String?  @db.VarChar(500)
 
  isBanned     Boolean   @default(false)
  bannedOn     DateTime?
  bannedUntil  DateTime?     // null => permanent
  banReason    String?
  bannedById   String?       // FK column required for relation
  bannedBy     User?     @relation("BansIssued", fields: [bannedById], references: [id], onDelete: SetNull)
  bansIssued   User[]    @relation("BansIssued") // admins -> users they banned
  @@index([isBanned])
  @@index([bannedUntil])
 
  sessions     Session[]
  tokens       Token[]
 
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
 
  following        Follow[]    @relation("Following") // edges out
  followers        Follow[]    @relation("Followers") // edges in
 
  blocksInitiated  UserBlock[] @relation("BlocksInitiated")
  blocksReceived   UserBlock[] @relation("BlocksReceived")
}
 
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
 
  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
 
  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
 
model Session {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
 
  ip           String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?
 
  @@index([userId])
}
 
model Token {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
 
  accessToken  String
  refreshToken String
  createdAt    DateTime @default(now())
  expiresAt   DateTime
}
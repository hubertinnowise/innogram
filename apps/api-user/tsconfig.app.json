{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/apps/api-user",
        "module": "commonjs",
        "types": ["node"],
        "emitDecoratorMetadata": true,
        "target": "es2021",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@core/*": ["src/core/*"],
            "packages/*": ["../../packages/*"]
        }
    },
    "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"],
    "include": ["src/**/*.ts", "../../packages/utils/**/*.ts", "../../packages/jwt-auth.guard.ts"]
}

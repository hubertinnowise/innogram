generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  passwordHash String
  createdAt DateTime @default(now())

  sessions  Session[]
  tokens    Token?
}

model Session {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String

  ip           String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?

  @@index([userId])
}

model Token {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  
  accessToken  String
  refreshToken String
  createdAt    DateTime @default(now())
  expiresAt   DateTime
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-post"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostMediaType {
  IMAGE
  VIDEO
  GIF
  OTHER
}

model User {
  id                String   @id @default(uuid())
  authoredPosts     Post[]
  comments          Comment[]
  commentReplies    CommentReply[]
  
  postLikes         PostLike[]
  commentLikes      CommentLike[]
  commentReplyLikes CommentReplyLike[]
}

/// moze jeszcze jakies pole dot. privacy ze tam isPublic czy nie 
/// category tez jakies byc musi absolutnie
model Post {
  id         String      @id @default(uuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content    String      @db.Text
  media      PostMedia[]

  category   String?     @db.VarChar(64)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  likes      PostLike[]
  comments   Comment[]

  @@index([category])
  @@index([authorId])
  @@index([createdAt])
}

model PostMedia {
  id         String         @id @default(uuid())
  postId     String
  post       Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  type       PostMediaType  
  bucket     String        
  objectKey  String        
  url        String?        

  position   Int            @default(0)
  width      Int?
  height     Int?
  durationMs Int?                      

  createdAt  DateTime       
  updatedAt  DateTime       
  
  @@index([postId])
  @@unique([bucket, objectKey])
  @@unique([postId, position])
}

model PostLike {
  id            String   @id @default(uuid())
  userId        String
  postId        String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

/// czy deletedAt
model Comment {
  id              String   @id @default(uuid())
  postId          String
  authorId        String
  content         String   @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post            Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes           CommentLike[]
  commentReplies  CommentReply[]

  @@index([postId])
  @@index([authorId])
}

model CommentLike {
  userId     String
  commentId  String
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
  @@index([userId, createdAt])
}

/// czy deletedAt
model CommentReply {
  id         String   @id @default(uuid())
  commentId  String
  authorId   String
  content    String   @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author     User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes      CommentReplyLike[]

  @@index([commentId])
  @@index([authorId])
}

model CommentReplyLike {
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply  CommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@index([replyId])
  @@index([userId, createdAt])
}

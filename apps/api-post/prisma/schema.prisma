generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostMediaType {
  IMAGE
  VIDEO
  GIF
  OTHER
}

model User {
  id                String   @id @default(uuid())

  authoredPosts     Post[]
  comments          Comment[]
  commentReplies    CommentReply[]

  postLikes         PostLike[]
  commentLikes      CommentLike[]
  commentReplyLikes CommentReplyLike[]
}

model Post {
  id              String      @id @default(uuid())
  authorId        String
  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content         String      @db.Text

  // keep if you want a single "cover"; otherwise delete after migrating to PostMedia
  mediaBucket     String?
  mediaObjectKey  String?

  // NEW: one-to-many media
  media           PostMedia[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime?   @updatedAt
  deletedAt       DateTime?

  likes           PostLike[]
  comments        Comment[]

  @@index([authorId])
  @@index([createdAt])
}

model PostMedia {
  id         String         @id @default(uuid())
  postId     String
  post       Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  type       PostMediaType  // IMAGE/VIDEO/...
  bucket     String?        // e.g., "posts"
  objectKey  String?        // e.g., "2025/09/05/uuid/original.jpg"
  url        String?        // optional CDN/public URL if you resolve it at write-time

  // useful metadata for rendering
  position   Int            @default(0)      // ordering within the post (0..n)
  width      Int?
  height     Int?
  durationMs Int?                            // for videos/gifs

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([postId])
  @@index([postId, position])
}

model PostLike {
  id         String   @id @default(uuid())
  userId     String
  postId     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id           String   @id @default(uuid())
  postId       String
  authorId     String
  content      String   @db.Text

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post         Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes        CommentLike[]
  commentReplies CommentReply[]

  @@index([postId])
  @@index([authorId])
}

model CommentLike {
  userId     String
  commentId  String
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
  @@index([userId, createdAt])
}

model CommentReply {
  id         String   @id @default(uuid())
  commentId  String
  authorId   String
  content    String   @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author     User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes      CommentReplyLike[]

  @@index([commentId])
  @@index([authorId])
}

model CommentReplyLike {
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply  CommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@index([replyId])
  @@index([userId, createdAt])
}

{
    "name": "api-auth",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/api-auth/src",
    "projectType": "application",
    "tags": ["type:service", "scope:backend"],
    "targets": {
        "prisma-generate": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prisma generate",
                "cwd": "apps/api-auth"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{options.outputPath}"],
            "dependsOn": ["prisma-generate"],
            "options": {
                "outputPath": "dist/apps/api-auth",
                "command": "./scripts/build-api-auth.sh",
                "parallel": false,
                "assets": [
                    {
                        "input": "apps/api-auth/prisma/generated",
                        "glob": "**/*",
                        "output": "prisma/generated"
                    },
                    {
                        "input": "apps/api-auth/prisma",
                        "glob": "schema.prisma",
                        "output": "prisma"
                    }
                ]
            }
        },
        "serve": {
            "executor": "@nx/js:node",
            "options": {
                "buildTarget": "api-auth:build"
            },
            "configurations": {
                "development": {
                    "buildTarget": "api-auth:build:development"
                },
                "production": {
                    "buildTarget": "api-auth:build:production"
                }
            },
            "defaultConfiguration": "development"
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": ["apps/api-auth/**/*.ts"]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/apps/api-auth"],
            "options": {
                "jestConfig": "apps/api-auth/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
